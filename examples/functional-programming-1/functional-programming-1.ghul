use IO.Std.write_line
use Ghul.Pipes

// >>>
// a function literal, held in a variable
let triple = (n: int) => n * 3
write_line("triple(5): {triple(5)}")

// a named function, passed by name
double(n: int) -> int => n * 2

write_line("doubled: {[1, 2, 3] |> map(double)}")

// an operator, passed as a value
⊕(total: int, digit: int) -> int => total * 10 + digit

write_line("digits: {[4, 0, 2] |> reduce(0, `⊕)}")
// <<<
