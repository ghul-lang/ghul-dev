use IO.Std.write_line

class Customer is
    name: string
    init(name: string) is self.name = name; si
si

class Order is
    customer: Customer?
    init(customer: Customer?) is self.customer = customer; si
si

let order = Order(Customer("mimi"))
// >>>
if let order.customer then
    write_line(customer.name)
fi
// <<<
