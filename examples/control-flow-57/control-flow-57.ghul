use IO.Std.write_line

class Animal abstract is
    name() -> string
si

class Cat: Animal is
    init() is si
    name() -> string => "cat"
    purr() -> string => "purr"
si

any_animal() -> Animal => Cat()

let pet mut = any_animal()
// >>>
pet = Cat()
// assigning a Cat narrows pet to Cat, so purr() is in reach
write_line(pet.purr())
// <<<
