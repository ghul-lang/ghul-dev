// expect: error
use IO.Std.write_line

class Animal abstract is
    init() is si
si

class Cat: Animal is
    init() is super.init(); si
    purr() -> string => "purr"
si

class Carrier(occupant: Animal) is
    swap(a: Animal) is
        occupant = a
    si
si

// >>>
describe(carrier: Carrier, other: Animal) is
    if isa Cat(carrier.occupant) then
        carrier.swap(other)
        // the narrowing ends at the call: swap() can change
        // occupant, so it reads as an Animal from here on
        write_line(carrier.occupant.purr())
    fi
si

describe(Carrier(Cat()), Cat())
// <<<
