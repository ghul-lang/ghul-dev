use IO.Std.write_line

// >>>
class Slot[T] is
    _stored: T?

    init() is si

    put(value: T) is _stored = value; si

    take() -> T? is
        let result = _stored
        _stored = null
        return result
    si
si

let s = Slot[int]()
s.put(42)
write_line("{s.take() ?? -1}")
write_line("{s.take() ?? -1}")
// <<<
