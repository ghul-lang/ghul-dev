use IO.Std.write_line

// >>>
class Temperatura is
    grados: double

    init(grados: double) is
        self.grados = grados
    si

    en_fahrenheit() -> double => grados * 1.8 + 32.0
si

面積(幅: double, 高さ: double) -> double => 幅 * 高さ

let máxima = Temperatura(21.5)

write_line("{máxima.en_fahrenheit()}")
write_line("{面積(3.0, 4.0)}")
