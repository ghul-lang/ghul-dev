use IO.Std.write_line

class Animal abstract is
    init() is si
si

class Cat: Animal is
    init() is super.init(); si
    meow() -> string => "meow"
si

class Dog: Animal is
    init() is super.init(); si
    bark() -> string => "woof"
si

describe(a: Animal) -> string =>
// >>>
    case a
    when c: Cat then c.meow()
    when d: Dog then d.bark()
    esac

write_line(describe(Cat()))
// <<<
