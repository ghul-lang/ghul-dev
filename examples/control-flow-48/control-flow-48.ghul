use IO.Std.write_line

fetch_async(x: int) -> Tasks.Future[int] => x * x

// >>>
sum_of_squares(xs: Collections.List[int]) -> Tasks.Future[int] is
    let total mut = 0

    for x in xs do
        let y = await fetch_async(x)
        total = total + y
    od

    return total
si

let result = sum_of_squares([1, 2, 3, 4]).result

write_line("sum_of_squares = {result}")
