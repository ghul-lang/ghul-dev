use IO.Std.write_line
use Collections.Iterable
use Collections.Iterator
use Ghul.Pipes.Pipe

// >>>
class Countdown(from: int): Iterable[int] is
    iterator: Iterator[int] => _counting().iterator

    _counting() -> int{} is
        let i mut = from
        while i > 0 do
            yield i
            i = i - 1
        od
    si
si

for i in Countdown(3) do
    write_line("tick {i}")
od
// <<<
