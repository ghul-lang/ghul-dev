use IO.Std.write_line

// >>>
// T: out marks Box[T] as covariant in T - a Box[Cat] is also a Box[Animal]
trait Box[T: out] is
    contents() -> T
si
// <<<

trait Animal is
    speak() -> string
si

class Cat(): Animal is
    speak() -> string => "meow"
si

class CatBox(): Box[Cat] is
    contents() -> Cat => Cat()
si

// >>>
let cats: Box[Cat] = CatBox()
let animals: Box[Animal] = cats   // covariance

write_line(animals.contents().speak())
// <<<
