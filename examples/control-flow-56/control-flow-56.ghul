use IO.Std.write_line

class Animal abstract is
    name() -> string
si

class Cat: Animal is
    init() is si
    name() -> string => "cat"
    purr() -> string => "purr"
si

class Dog: Animal is
    init() is si
    name() -> string => "dog"
si

any_animal() -> Animal => Cat()

let pet mut = any_animal()
// >>>
if isa Cat(pet) then
    write_line(pet.purr())

    pet = Dog()
    // reassigning cancels the Cat narrowing and
    // introduces a Dog one: pet is Dog here
    write_line(pet.name())
fi
// <<<
