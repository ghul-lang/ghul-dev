use IO.Std.write_line

class Box[T](value: T)

// >>>
let closed = typeof Box[int]

// Box[_] names the open generic, before any type argument is supplied
let open = typeof Box[_]

write_line("closed: {closed.name}, generic: {closed.is_generic_type}")
write_line("open: {open.name}, definition: {open.is_generic_type_definition}")
write_line("same definition: {closed.get_generic_type_definition() == open}")
// <<<
