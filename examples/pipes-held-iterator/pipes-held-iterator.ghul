use IO.Std.write_line
use Ghul.Pipes

let path = IO.Path.get_temp_file_name()
IO.File.write_all_lines(path, ["a", "few", "longer", "lines"])

// >>>
first_long_line(path: string) -> string? =>
    cursor(use IO.File.read_lines(path).iterator) |> find(line => line.length > 4)

write_line(first_long_line(path) ?? "none")
// <<<

IO.File.delete(path)
