use IO.Std.write_line
use Concurrency

// an asynchronous function returns Future
worker(name: string, steps: int) -> Future is
    for step in 1::steps do
        write_line("{name} step {step}")

        // give the other workers a turn
        await pause()
    od
si

let a = worker("a", 3)
let b = worker("b", 2)

run(() => Future.when_all([a, b]))
