use IO.Std.write_line
// >>>
class Vector is
    x: int
    y: int

    init(x: int, y: int) is
        self.x = x
        self.y = y
    si

    // a binary operator as an instance method takes one parameter, the right operand:
    +(other: Vector) -> Vector => Vector(x + other.x, y + other.y)
si

let sum = Vector(1, 2) + Vector(3, 4)
write_line("({sum.x}, {sum.y})")
// <<<
