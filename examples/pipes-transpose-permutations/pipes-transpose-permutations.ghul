use IO.Std.write_line
use Ghul.Pipes

// >>>
let rows = [[1, 2, 3], [4, 5, 6]]

// transpose: the columns of rows, each as a list
for column in rows |> transpose() do
    write_line("column: {column |> join(", ")}")
od

// permutations: every ordering of the elements
for ordering in ["a", "b", "c"] |> permutations() do
    write_line("ordering: {ordering |> join("")}")
od
// <<<
