use IO.Std.write_line

side_effect(label: string) -> Concurrency.Future is
    write_line("side effect: {label}")

    return Concurrency.Future.completed_task
si

// >>>
run_side_effects() -> Concurrency.Future is
    await side_effect("first")
    await side_effect("second")

    return
si

run_side_effects().wait()
// <<<
