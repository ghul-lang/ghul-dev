use Microsoft.EntityFrameworkCore.DbContext
use Microsoft.EntityFrameworkCore.DbSet
use Microsoft.EntityFrameworkCore.DbContextOptions

// >>>
// @IL.name maps these onto the PascalCase names EF Core's conventions expect.
class Product is
    @IL.name("Id")
    id: int public

    @IL.name("Name")
    name: string public

    init() is si
si

class StoreContext: DbContext is
    @IL.name("Products")
    products: DbSet[Product]

    init(options: DbContextOptions) is
        super.init(options)
    si
si

add_product(context: StoreContext, product: Product) -> Tasks.TASK is
    context.products.add(product)

    await context.save_changes_async(System.Threading.CancellationToken.none)

    return
si
// <<<

entry() is si
