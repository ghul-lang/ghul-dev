use IO.Std.write_line

// >>>
// every instance member of a pure type must read and never
// write; a bodiless member holds implementors to the same rule
trait Named pure is
    name: string
    label() -> string
si

class USER: Named is
    name: string

    init(name: string) is
        self.name = name
    si

    label() -> string => "<{name}>"
si

write_line(USER("ada").label())
// <<<
