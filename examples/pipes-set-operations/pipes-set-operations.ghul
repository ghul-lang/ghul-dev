use IO.Std.write_line
use Ghul.Pipes

// >>>
let left = [1, 2, 2, 3, 4]
let right = [3, 4, 5]

// all four remove duplicates, keeping the first occurrence
// of each element
write_line("distinct:      {left |> distinct()}")
write_line("left | right:  {left | right}")
write_line("left & right:  {left & right}")
write_line("left -- right: {left -- right}")
// <<<
