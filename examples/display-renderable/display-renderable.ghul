use IO.Std.write_line
use Ghul

// >>>
class Greeting(name: string): Renderable is
    representations() -> Collections.Iterable[(mime: string, content: ARRAY[ubyte])] pure =>
        [
            (mime = "text/markdown", content = System.Text.Encoding.utf8.get_bytes("**hello** {name}")),
            (mime = "text/plain", content = System.Text.Encoding.utf8.get_bytes("hello {name}"))
        ]
si

for (mime, content) in Greeting("world").representations() do
    write_line("{mime}: {content.count} bytes")
od
// <<<
