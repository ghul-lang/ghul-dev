use IO.Std.write_line

union Shape is
    CIRCLE(radius: double)
    SQUARE(side: double)
si

use Shape.CIRCLE
use Shape.SQUARE

// >>>
area(s: Shape) -> double =>
    // case over a union is checked for exhaustiveness: every variant
    // is covered here, so no else arm is needed
    case s
    when c: CIRCLE then 3.14159 * c.radius * c.radius
    when q: SQUARE then q.side * q.side
    esac

write_line("{area(CIRCLE(2.0))}")
write_line("{area(SQUARE(3.0))}")
// <<<
