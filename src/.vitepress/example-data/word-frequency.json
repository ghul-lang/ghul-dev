{
  "name": "word-frequency",
  "snippet": false,
  "code": "use IO.Std.write_line\nuse Collections.MAP\nuse Ghul.Pipes\n\nlet text =\n    \"the quick brown fox jumps over the lazy dog. \"\n    \"the dog sleeps; the fox does not. \"\n    \"a quick fox is a happy fox\"\n\n// split on anything that is not a letter, and drop the empty\n// strings that two separators in a row leave behind\nlet words =\n    text.split([' ', '.', ';'])\n        |> filter(word => word.length > 0)\n\n// count each word\nlet counts = MAP[string, int]()\n\nfor word in words do\n    counts[word] = (if counts.contains_key(word) then counts[word] else 0 fi) + 1\nod\n\n// the five most frequent, most frequent first. a map iterates\n// as key and value pairs, which destructure in the lambda\ncounts\n    |> sort(((_, a), (_, b)) => b - a)\n    |> take(5)\n    |> each(((word, count)) => write_line(\"{count} {word}\"))",
  "fullSource": "use IO.Std.write_line\nuse Collections.MAP\nuse Ghul.Pipes\n\nlet text =\n    \"the quick brown fox jumps over the lazy dog. \"\n    \"the dog sleeps; the fox does not. \"\n    \"a quick fox is a happy fox\"\n\n// split on anything that is not a letter, and drop the empty\n// strings that two separators in a row leave behind\nlet words =\n    text.split([' ', '.', ';'])\n        |> filter(word => word.length > 0)\n\n// count each word\nlet counts = MAP[string, int]()\n\nfor word in words do\n    counts[word] = (if counts.contains_key(word) then counts[word] else 0 fi) + 1\nod\n\n// the five most frequent, most frequent first. a map iterates\n// as key and value pairs, which destructure in the lambda\ncounts\n    |> sort(((_, a), (_, b)) => b - a)\n    |> take(5)\n    |> each(((word, count)) => write_line(\"{count} {word}\"))\n",
  "hiddenBefore": false,
  "hiddenAfter": false,
