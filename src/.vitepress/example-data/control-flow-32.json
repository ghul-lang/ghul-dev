  "code": "classify(value: int) -> string is\n    case value\n    when -1 then\n        return \"minus one\"\n\n    when 0 then\n        let result = \"zero\"\n        return result\n\n    when 1 then\n        return \"one\"\n\n    when 2 then\n        return \"two\"\n\n    when 3 then\n        return \"three\"\n\n    when 4 then\n        return \"four\"\n\n    when 5 then\n        let result = \"five\"\n        return result\n\n    when 6, 7, 8, 9 then\n        return \"more than five and less than ten\"\n\n    when 13 then\n        return \"unlucky\"\n\n    else\n        return \"less than -1 or more than nine\"\n    esac\nsi\n\nwrite_line(classify(0))\nwrite_line(classify(3))\nwrite_line(classify(7))\nwrite_line(classify(13))\nwrite_line(classify(-5))",
