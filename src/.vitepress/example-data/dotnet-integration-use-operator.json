  "code": "open(name: string) -> string is\n    let scope = use SCOPE(name)\n\n    write_line(scope.read())\n\n    return \"done with {name}\"\nsi\n\nwrite_line(open(\"first\"))\n\nlet length = (let use second = SCOPE(\"second\") in second.read().length)\n\nwrite_line(\"{length}\")",
