  "code": "grade(score: int) -> string is\n    // a block as a let initializer, composing a case and an if:\n    let label = (\n        let band =\n            case score / 10\n            when 10, 9 then \"A\"\n            when 8 then \"B\"\n            when 7 then \"C\"\n            else \"F\"\n            esac\n\n        if band == \"F\" then \"fail\" else \"pass ({band})\" fi\n    )\n\n    return label\nsi\n\nwrite_line(grade(95))\nwrite_line(grade(82))\nwrite_line(grade(60))",
