  "code": "class Greeting(name: string): Renderable is\n    representations() -> Collections.Iterable[(mime: string, content: ARRAY[ubyte])] pure =>\n        [\n            (mime = \"text/markdown\", content = System.Text.Encoding.utf8.get_bytes(\"**hello** {name}\")),\n            (mime = \"text/plain\", content = System.Text.Encoding.utf8.get_bytes(\"hello {name}\"))\n        ]\nsi\n\nfor (mime, content) in Greeting(\"world\").representations() do\n    write_line(\"{mime}: {content.count} bytes\")\nod",
